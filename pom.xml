<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.neobank</groupId>
    <artifactId>neobank-sidecar</artifactId>
    <version>1.0.0</version>
    <name>neobank-sidecar</name>
    <description>Mock orchestrator box: dispatches applications to a module and receives its callback</description>

    <properties>
        <java.version>21</java.version>
        <!--
          Override Spring Boot 3.3.4's Testcontainers (1.19.8, from 2024). Its bundled
          docker-java pins an old Docker API version that modern engines (Docker 28/29+,
          min API 1.40) reject with HTTP 400 → "Could not find a valid Docker environment".
          1.21.x negotiates the API version, so the *IT tests work on current Docker Desktop
          and on CI runners.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!--
          Integration tests (*IT) need Docker. They are SKIPPED by default so a local
          `mvn verify` is always green and fast even when Docker Desktop is stopped.
          CI sets CI=true, which activates the `integration` profile below. To run them
          locally, start Docker and use `mvn verify -DskipITs=false`.
        -->
        <skipITs>true</skipITs>
    </properties>

    <!--
      Deliberately NO actuator and NO springdoc. The sidecar is a development tool with a
      hand-written /health and /info and a static page; both starters were dead weight in
      the module template they were copied from and are dead weight here.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean validation on the callback body: the wire shape is the point of this box -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Persistence: schema owned by Liquibase, ddl-auto=validate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Unit + slice tests run DB-free against in-memory H2 (no Docker for `mvn test`) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Integration tests (*IT) run against a REAL MySQL 8 via Testcontainers on `mvn verify` -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                  Writes META-INF/build-info.properties (version + build time) into the jar, so
                  /info and the UI can state WHICH sidecar is running.

                  This matters because of how the sidecar is distributed. A registry tag is
                  visible in `docker images`; a git-context build's provenance is not, so without
                  this there is no way to answer "did that team pick up the fix?" across ten
                  machines. The build timestamp answers it.
                -->
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Surefire runs unit/slice tests (*Test) on `mvn test` — fast, no Docker.
              Failsafe runs integration tests (*IT) on `mvn verify` — these need Docker.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration</id>
            <activation>
                <property>
                    <name>env.CI</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>
</project>
